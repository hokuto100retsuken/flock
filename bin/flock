#!/bin/sh
# flock の zellij セッションを起動・操作する。
#   flock              起動する。起動中なら繋ぎ直し、終了していたら前のタブを会話の続きから開き直す
#   flock new [DIR] [--name NAME]
#                      新しいタブで Claude Code を起動する（DIR の既定は今のフォルダ、NAME の既定はフォルダ名）
#   flock focus N      サイドバーの N 番のエージェントへ移動する
#   flock next|prev    次 / 前のエージェントへ移動する
set -eu

root=$(cd "$(dirname "$(realpath "$0")")/.." && pwd)
session=${ZELLIJ_SESSION_NAME:-flock}

# サイドバーへ操作を送る。受け取れないときに止まらないよう、2秒で諦める
send() {
    ZELLIJ_SESSION_NAME=$session zellij pipe --name "$1" ${2:+--args "$2"} -- "$1" >/dev/null 2>&1 </dev/null &
    pipe=$!
    ( sleep 2; kill "$pipe" 2>/dev/null ) >/dev/null 2>&1 </dev/null &
    wait "$pipe" 2>/dev/null || true
    kill $! 2>/dev/null || true
}

# 起動に使うレイアウト。サイドバーが書き出したタブの並びがあれば、そのタブを並べたものを作る
layout() {
    tabs=${XDG_STATE_HOME:-$HOME/.local/state}/flock/$session.tabs
    if [ ! -s "$tabs" ]; then
        echo "$root/layouts/flock.kdl"
        return
    fi
    out=${TMPDIR:-/tmp}/flock-$session.kdl
    # flock.kdl の tab name="main" より前（テンプレート）はそのまま使い、タブだけを差し替える
    sed '/^    tab name="main"/,$d' "$root/layouts/flock.kdl" >"$out"
    # 1行に1タブ「名前 タブ フォルダ タブ 会話の ID」
    awk -F '\t' '
        function q(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return "\"" s "\"" }
        {
            printf "    tab name=%s cwd=%s%s {\n", q($1), q($2), (NR == 1 ? " focus=true" : "")
            if ($3 != "") printf "        pane command=\"claude\" close_on_exit=true {\n            args \"--resume\" %s\n        }\n", q($3)
            else print "        pane"
            print "    }"
        }
        END { print "}" }' "$tabs" >>"$out"
    echo "$out"
}

case ${1:-} in
"")
    if [ -n "${ZELLIJ:-}" ]; then
        echo "zellij の中では起動できません。flock new で新しいタブを開いてください" >&2
        exit 1
    fi
    state=$(zellij list-sessions --no-formatting 2>/dev/null | awk -v s="$session" '$1 == s { print (/EXITED/ ? "exited" : "running") }')
    case $state in
    running) exec zellij attach "$session" ;;
    # 終了済みのセッションを復元すると、そのときのレイアウトと設定のまま戻ってしまうので作り直す
    exited) zellij delete-session "$session" >/dev/null ;;
    esac
    exec zellij --session "$session" --new-session-with-layout "$(layout)"
    ;;
new)
    shift
    dir=. name=
    while [ $# -gt 0 ]; do
        case $1 in
        --name) name=${2:?名前を指定してください}; shift 2 ;;
        *) dir=$1; shift ;;
        esac
    done
    dir=$(cd "$dir" && pwd)
    send flock-new "cwd=$dir${name:+,name=$name}"
    ;;
focus)
    send flock-focus "n=${2:?番号を指定してください}"
    ;;
next | prev)
    send "flock-$1"
    ;;
*)
    sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 1
    ;;
esac
