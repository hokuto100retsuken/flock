// 左に flock のサイドバー、右にエージェントのログを置くレイアウト
// 使い方: zellij --layout <このファイル>
layout {
    default_tab_template {
        pane split_direction="vertical" {
            pane size=32 borderless=true {
                plugin location="file:/Users/hokuto100retsuken/src/github.com/hokuto100retsuken/flock/target/wasm32-wasip1/release/flock.wasm" {
                    claude_command "claude"
                }
            }
            children
            pane size=40 borderless=true {
                plugin location="file:/Users/hokuto100retsuken/src/github.com/hokuto100retsuken/flock/target/wasm32-wasip1/release/flock.wasm" {
                    mode "log"
                }
            }
        }
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }
    // default_tab_template だけだと、後から開いたタブの children がペインにならず空のタブになる
    new_tab_template {
        pane split_direction="vertical" {
            pane size=32 borderless=true {
                plugin location="file:/Users/hokuto100retsuken/src/github.com/hokuto100retsuken/flock/target/wasm32-wasip1/release/flock.wasm" {
                    claude_command "claude"
                }
            }
            pane
            pane size=40 borderless=true {
                plugin location="file:/Users/hokuto100retsuken/src/github.com/hokuto100retsuken/flock/target/wasm32-wasip1/release/flock.wasm" {
                    mode "log"
                }
            }
        }
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }
    tab name="main" {
        pane
    }
}
