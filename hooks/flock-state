#!/bin/sh
# Claude Code のフックから呼び、このペインの状態を flock に送る。
# 使い方: flock-state working|blocked|stop|idle|end
# zellij の外では何もしない。フックを止めないよう、送信の失敗は無視する。
[ -n "$ZELLIJ_PANE_ID" ] || exit 0
input=$(cat)
# ログに出す1行。指示なら1行目、ツールなら名前と対象（ファイル名やコマンド）、許可待ちならその文言
detail=$(printf '%s' "$input" | jq -r '
  def line: tostring | (split("\n")[0] // "") | gsub("\t"; " ") | .[:200];
  (.tool_input // {}) as $in
  | if .hook_event_name == "UserPromptSubmit" then "> " + (.prompt | line)
    elif .hook_event_name == "PostToolUse" then
      .tool_name + " " + (($in.file_path // $in.notebook_path | values | split("/") | last)
        // ($in.command // $in.pattern // $in.url // $in.description // "" | line))
    elif .hook_event_name == "Notification" then .message | line
    else empty end' 2>/dev/null)
# ログの行を押したときに開く詳細。指示は全文、ツールは入力のすべてと結果の先頭
file=
if [ -n "$detail" ]; then
    dir=${XDG_STATE_HOME:-$HOME/.local/state}/flock/events
    mkdir -p "$dir"
    file=$dir/$(date +%Y%m%d%H%M%S)-$$.txt
    printf '%s' "$input" | jq -r '
      def text: if type == "string" then . else tojson end;
      if .hook_event_name == "UserPromptSubmit" then .prompt
      elif .hook_event_name == "PostToolUse" then
        .tool_name, "",
        (.tool_input // {} | to_entries[] | "[\(.key)]", (.value | text), ""),
        "[結果]", (.tool_response | text | .[:4000])
      else .message end' >"$file" 2>/dev/null || file=
    find "$dir" -name '*.txt' -mtime +1 -delete 2>/dev/null
fi
# 中身は「時刻 タブ 詳細のファイル タブ ログの1行」
# 会話の ID。Ctrl+q で終了した後に flock を開き直すと、この会話の続きから起動する
session=$(printf '%s' "$input" | jq -r '.session_id // empty' 2>/dev/null)
zellij pipe --name flock --args "pane=$ZELLIJ_PANE_ID,state=$1${session:+,session=$session}" -- "$(printf '%s\t%s\t%s' "$(date +%H:%M)" "$file" "$detail")" >/dev/null 2>&1 </dev/null &
pipe=$!
# サイドバーが権限の確認待ちなどで受け取れないと pipe は返ってこないので、2秒で諦める。
# 見張りの sleep が出力をつかむと、呼び出し元（Claude Code）がそれが閉じるまで待つので、出力を外す
( sleep 2; kill "$pipe" 2>/dev/null ) >/dev/null 2>&1 </dev/null &
wait "$pipe" 2>/dev/null
kill $! 2>/dev/null
exit 0
